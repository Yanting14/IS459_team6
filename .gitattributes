# Terraform hashes the job scripts and the Lambda zip, so their bytes must not depend on
# the checkout's platform: Python is LF everywhere.
*.py text eol=lf
# The same for the dashboard zip; and dashboard.tf holds a bash user_data heredoc that keeps CRs.
dashboard/** text=auto eol=lf
infra/dashboard.tf text eol=lf
# Bash reads a CR as part of the command, in Git Bash and on Linux alike.
scripts/*.sh text eol=lf

# Frozen source hashes include line endings and upstream whitespace.
# Preserve the supplied bytes and exclude these copies from whitespace linting.
# Last, so it overrides the rule above.
scoring/vendor/* -text -whitespace
